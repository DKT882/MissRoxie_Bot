# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# TELEGRAM_BOT_TOKEN: Required for Telegram Bot API integration.
# Configured securely via Settings > Secrets in Google AI Studio.
# Never expose this secret to the client-side browser.
TELEGRAM_BOT_TOKEN=""

# OPENROUTER_API_KEY: Required for Roxie AI Chatbot features via OpenRouter.
OPENROUTER_API_KEY=""

# OPENROUTER_MODEL: Optional OpenRouter model identifier (default: deepseek/deepseek-chat).
OPENROUTER_MODEL=""

# TELEGRAM_STICKERS_JSON / TELEGRAM_ANIMATIONS_JSON: Optional JSON configuration for mood-based Telegram sticker & GIF file_ids.
# Alternatively, configure individual mood variables (e.g., TELEGRAM_STICKER_CUTE, TELEGRAM_ANIMATION_ROMANTIC).
TELEGRAM_STICKERS_JSON=""
TELEGRAM_ANIMATIONS_JSON=""
